# Leave unset to use /public/hero-bg.mp4 and /public/hero-poster.webp.
# For large media, point these to a CDN/object-store URL such as Vercel Blob.
NEXT_PUBLIC_HERO_VIDEO_URL=
NEXT_PUBLIC_HERO_POSTER_URL=
# Set to the final canonical origin before launch, for example https://example.com.
NEXT_PUBLIC_SITE_URL=

# Private contact delivery. Omit CONTACT_DELIVERY_MODE to auto-select webhook
# when CONTACT_WEBHOOK_URL exists, local file storage on persistent Node hosts,
# and an honest unavailable state on known ephemeral serverless hosts.
# CONTACT_DELIVERY_MODE=webhook
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_BEARER_TOKEN=
# Optional persistent directory for CONTACT_DELIVERY_MODE=file.
CONTACT_STORAGE_DIR=
